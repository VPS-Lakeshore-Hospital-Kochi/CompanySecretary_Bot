# Copy this file to .env and fill in the values.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use (default claude-opus-5)
# CS_MODEL=claude-opus-5

# Optional: set a password so only your team can open the tool on the office network
# APP_PASSWORD=choose-a-strong-password

# Optional: turn off web look-ups of official government sites (default on)
# CS_WEB_SEARCH=0

# Optional: port (default 8080)
# PORT=8080
