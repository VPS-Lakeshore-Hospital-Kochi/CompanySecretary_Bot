# Copy this file to .env and fill in the values.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model to use (default claude-opus-5)
# CS_MODEL=claude-opus-5

# ---- Running as a site for the whole team ----
# Listen on the network (default is this computer only). With Docker leave this out.
# HOST=0.0.0.0
# Set to 1 once the site is served over HTTPS (keeps the sign-in cookie on HTTPS only).
# COOKIE_SECURE=1
# Create the first administrator automatically (otherwise the first visitor sees a setup screen).
# ADMIN_USERNAME=cs
# ADMIN_NAME=Company Secretary
# ADMIN_PASSWORD=choose-a-strong-password
# Secret used to sign sign-in cookies. Generated automatically in the data folder if not set.
# SECRET_KEY=

# Optional: turn off web look-ups of official government sites (default on)
# CS_WEB_SEARCH=0

# Optional: port (default 8080) and where the database and library files are kept (default ./data)
# PORT=8080
# CS_DATA_DIR=./data
